# ==========================================
# Pragati Frontend Environment Variables
# ==========================================

# Supabase Credentials (public anon key is safe for client-side auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Base URL (leave empty in local dev to use Vite proxy, set in production)
# Example for Render / Railway backend: https://pragati-backend.onrender.com
VITE_API_URL=https://your-backend-service.onrender.com
