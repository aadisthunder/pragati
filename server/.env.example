# ==========================================
# Pragati Backend Environment Variables
# ==========================================

# Server Port (default: 5000)
PORT=5000

# Node Environment (development | production)
NODE_ENV=production

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq API Key (from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Overrides (Optional - defaults to tested models)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# CORS Allowed Client Domains (comma-separated for production frontend)
# Example: https://pragati.vercel.app,https://my-domain.com
CLIENT_URL=https://your-frontend-domain.vercel.app
CORS_ORIGIN=https://your-frontend-domain.vercel.app
